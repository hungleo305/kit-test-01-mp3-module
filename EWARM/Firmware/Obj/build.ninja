#Generating source browse information for project Firmware


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.3\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.3\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.3\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Buzzer.pbi : index Buzzer.xcl
build CanBus.pbi : index CanBus.xcl
build I2cBus.pbi : index I2cBus.xcl
build Led.pbi : index Led.xcl
build Led7Segment.pbi : index Led7Segment.xcl
build main.pbi : index main.xcl
build Mp3.pbi : index Mp3.xcl
build Relay.pbi : index Relay.xcl
build Rfid.pbi : index Rfid.xcl
build Rtc.pbi : index Rtc.xcl
build SdCard.pbi : index SdCard.xcl
build Sensor.pbi : index Sensor.xcl
build SpiBus.pbi : index SpiBus.xcl
build stm32f1xx_hal_msp.pbi : index stm32f1xx_hal_msp.xcl
build stm32f1xx_it.pbi : index stm32f1xx_it.xcl
build SystemTimer.pbi : index SystemTimer.xcl
build fatfs.pbi : index fatfs.xcl
build user_diskio.pbi : index user_diskio.xcl
build system_stm32f1xx.pbi : index system_stm32f1xx.xcl
build stm32f1xx_hal.pbi : index stm32f1xx_hal.xcl
build stm32f1xx_hal_can.pbi : index stm32f1xx_hal_can.xcl
build stm32f1xx_hal_cortex.pbi : index stm32f1xx_hal_cortex.xcl
build stm32f1xx_hal_dma.pbi : index stm32f1xx_hal_dma.xcl
build stm32f1xx_hal_exti.pbi : index stm32f1xx_hal_exti.xcl
build stm32f1xx_hal_flash.pbi : index stm32f1xx_hal_flash.xcl
build stm32f1xx_hal_flash_ex.pbi : index stm32f1xx_hal_flash_ex.xcl
build stm32f1xx_hal_gpio.pbi : index stm32f1xx_hal_gpio.xcl
build stm32f1xx_hal_gpio_ex.pbi : index stm32f1xx_hal_gpio_ex.xcl
build stm32f1xx_hal_pwr.pbi : index stm32f1xx_hal_pwr.xcl
build stm32f1xx_hal_rcc.pbi : index stm32f1xx_hal_rcc.xcl
build stm32f1xx_hal_rcc_ex.pbi : index stm32f1xx_hal_rcc_ex.xcl
build stm32f1xx_hal_spi.pbi : index stm32f1xx_hal_spi.xcl
build diskio.pbi : index diskio.xcl
build ff.pbi : index ff.xcl
build ff_gen_drv.pbi : index ff_gen_drv.xcl
build syscall.pbi : index syscall.xcl
build Firmware_part0.pbi : link Buzzer.pbi CanBus.pbi I2cBus.pbi Led.pbi Led7Segment.pbi main.pbi
build Firmware_part1.pbi : link Mp3.pbi Relay.pbi Rfid.pbi Rtc.pbi SdCard.pbi Sensor.pbi
build Firmware_part2.pbi : link SpiBus.pbi stm32f1xx_hal_msp.pbi stm32f1xx_it.pbi SystemTimer.pbi fatfs.pbi user_diskio.pbi
build Firmware_part3.pbi : link system_stm32f1xx.pbi stm32f1xx_hal.pbi stm32f1xx_hal_can.pbi stm32f1xx_hal_cortex.pbi stm32f1xx_hal_dma.pbi stm32f1xx_hal_exti.pbi
build Firmware_part4.pbi : link stm32f1xx_hal_flash.pbi stm32f1xx_hal_flash_ex.pbi stm32f1xx_hal_gpio.pbi stm32f1xx_hal_gpio_ex.pbi stm32f1xx_hal_pwr.pbi stm32f1xx_hal_rcc.pbi
build Firmware_part5.pbi : link stm32f1xx_hal_rcc_ex.pbi stm32f1xx_hal_spi.pbi diskio.pbi ff.pbi ff_gen_drv.pbi syscall.pbi
build Firmware.pbd : link Firmware_part0.pbi Firmware_part1.pbi Firmware_part2.pbi Firmware_part3.pbi Firmware_part4.pbi Firmware_part5.pbi
build Firmware.pbw : browsedata Firmware.pbd


